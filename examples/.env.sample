# =============================================================================
# django-nepali-payment example project — environment configuration
# =============================================================================
# Copy this file to .env and fill in your own merchant credentials.
# Never commit .env to version control.

# ---------- common ----------

# Django SECRET_KEY (used for session signing). For production, use a strong,
# unique random key here.
DJANGO_SECRET_KEY=django-insecure-example-only-not-for-production

# "sandbox" (default) or "production"
PAID_MODE=sandbox

# Public base URL used to build provider callback URLs. If empty, callback URLs
# are derived from the incoming request host. Set this when the provider must
# reach you at a public HTTPS address (LAN or deployed), e.g.
# PAID_BASE_URL=https://example.com
# PAID_BASE_URL=

# ---------- eSewa ----------

ESEWA_SECRET=8gBm/:&EnhH.1/q

# eSewa product code; EPAYTEST is the sandbox code from the .NET reference demo.
ESEWA_PRODUCT_CODE=EPAYTEST

# ---------- Khalti ----------

# Khalti test secret keys are issued from https://masspay.khalti.com / the
# merchant dashboard. The old generic "test_secret_key" is no longer accepted
# by the sandbox (401 Invalid token) and must be replaced with a real one.
KHALTI_SECRET=live_secret_key_68791341fdd94846a146f0457ff7b455

# ---------- Fonepay ----------

FONEPAY_SECRET=a7e3512f5032480a83137793cb2021dc
FONEPAY_MERCHANT=NBQM
FONEPAY_USERNAME=9861101076
FONEPAY_PASSWORD=admin123456

# Fonepay background-monitor settings (optional; defaults shown).
# How long to poll a payment before declaring it timed out, and the interval
# between status checks.
# FONEPAY_MONITOR_TIMEOUT=900
# FONEPAY_MONITOR_INTERVAL=5

# ---------- ConnectIPS ----------

# ConnectIPS (required for ConnectIPS). Set these to activate this gateway.
# CONNECTIPS_MERCHANT_ID=your_merchant_id
# CONNECTIPS_APP_ID=your_app_id
# CONNECTIPS_APP_NAME=your_app_name
# CONNECTIPS_APP_PASSWORD=your_app_password
# CONNECTIPS_CERT_PATH=/path/to/creditor.pfx
# CONNECTIPS_CERT_PASSWORD=cert_password

# Credentials used to pre-fill the mock ConnectIPS checkout (login/captcha/pin).
CONNECTIPS_DEMO_USER=nchluser
CONNECTIPS_DEMO_PASSWORD=Nepal@123
CONNECTIPS_DEMO_CAPTCHA=NCH07
CONNECTIPS_DEMO_TPIN=123456
CONNECTIPS_DEMO_OTP=987654
